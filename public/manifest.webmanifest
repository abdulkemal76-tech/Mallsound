{
  "id": "/",
  "name": "MallSound — Streaming Musik & Audio Studio",
  "short_name": "MallSound",
  "description": "Aplikasi streaming musik penuh (Spotify & YouTube Music style) dengan Equalizer 5-Band, Lirik Tersinkronisasi, DJ Mode, dan Koleksi Awan.",
  "theme_color": "#09090b",
  "background_color": "#09090b",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "start_url": "/",
  "scope": "/",
  "categories": ["music", "entertainment", "multimedia"],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
