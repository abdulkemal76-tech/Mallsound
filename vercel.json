{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|icon\\.svg|manifest\\.webmanifest|sw\\.js|pwa-.*|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
